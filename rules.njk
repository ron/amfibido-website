{# Entry point: redirect to /rules/en/, /rules/nl/, or /rules/de/ from geo + localStorage #}
<section class="py-16 bg-[#fafaf8] min-h-[40vh] flex items-center justify-center">
  <p class="text-gray-500 text-sm">Loading rules…</p>
</section>
<script>
(function () {
  var STORAGE_KEY = "amfibido_lang";
  function go(lang) {
    var target = "/rules/en/";
    if (lang === "nl") target = "/rules/nl/";
    else if (lang === "de") target = "/rules/de/";
    window.location.replace(target);
  }
  try {
    var stored = localStorage.getItem(STORAGE_KEY);
    if (stored === "nl" || stored === "en" || stored === "de") {
      go(stored);
      return;
    }
  } catch (e) {}
  fetch("https://ipapi.co/json/")
    .then(function (res) { return res.json(); })
    .then(function (data) {
      var cc = data && data.country_code;
      var lang = "en";
      if (cc === "NL" || cc === "BE") lang = "nl";
      else if (cc === "DE" || cc === "AT") lang = "de";
      try { localStorage.setItem(STORAGE_KEY, lang); } catch (e) {}
      go(lang);
    })
    .catch(function () {
      try { localStorage.setItem(STORAGE_KEY, "en"); } catch (e) {}
      go("en");
    });
})();
</script>
