{# Entry point: redirect to /rules/en/ or /rules/nl/ from geo + localStorage #}
<section class="py-16 bg-[#fafaf8] min-h-[40vh] flex items-center justify-center">
  <p class="text-gray-500 text-sm">Loading rules…</p>
</section>
<script>
(function () {
  var STORAGE_KEY = "amfibido_lang";
  function go(lang) {
    window.location.replace(lang === "nl" ? "/rules/nl/" : "/rules/en/");
  }
  try {
    var stored = localStorage.getItem(STORAGE_KEY);
    if (stored === "nl" || stored === "en") {
      go(stored);
      return;
    }
  } catch (e) {}
  fetch("https://ipapi.co/json/")
    .then(function (res) { return res.json(); })
    .then(function (data) {
      var cc = data && data.country_code;
      var lang = (cc === "NL" || cc === "BE") ? "nl" : "en";
      try { localStorage.setItem(STORAGE_KEY, lang); } catch (e) {}
      go(lang);
    })
    .catch(function () {
      try { localStorage.setItem(STORAGE_KEY, "en"); } catch (e) {}
      go("en");
    });
})();
</script>
