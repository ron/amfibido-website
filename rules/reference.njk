---
layout: base.njk
hideHeaderMobile: true
pagination:
  data: cardReference.languages
  size: 1
  alias: lang
permalink: /rules/{{ lang }}/reference/
eleventyComputed:
  title: "{{ (i18n[lang] or i18n.en).cardReference.documentTitle }}"
  description: "{{ (i18n[lang] or i18n.en).cardReference.title }}"
---
{% set ui = (i18n[lang] or i18n.en).cardReference %}
{% set pack = cardReference.byLang[lang] or cardReference.byLang[cardReference.fallbackSlug] %}
{% set cards = pack.cards %}

<section id="card-reference" class="bg-[#fafaf8] min-h-screen md:min-h-[calc(100vh-4rem)]">
  <div class="sticky top-0 z-40 border-b border-gray-200 bg-[#fafaf8]/95 backdrop-blur-sm">
    <div class="container mx-auto px-2 sm:px-4 py-2 sm:py-3">
      <div class="flex flex-col gap-2">
        <div class="flex items-center justify-between gap-2 sm:gap-3">
          <h1 class="text-2xl sm:text-3xl font-headings font-bold text-[#2d5a27] leading-tight truncate min-w-0">{{ ui.title }}</h1>
          <div class="flex items-center gap-1.5 sm:gap-2 shrink-0">
            <p id="card-reference-count" class="text-sm text-gray-500 whitespace-nowrap hidden md:block" data-template="{{ ui.resultCount }}">{{ cards.length }}</p>
            <a
              href="{{ ui.pdfUrl | url }}"
              target="_blank"
              rel="noopener noreferrer"
              data-i18n="cardReference.pdfLabel"
              data-i18n-href="cardReference.pdfUrl"
              class="inline-flex items-center gap-1.5 rounded-full border border-gray-200 bg-white px-2.5 py-1.5 text-xs sm:text-sm font-headings font-semibold text-[#2d5a27] hover:border-[#2d5a27]/40 hover:bg-[#2d5a27]/5 transition-colors"
              title="{{ ui.pdfLabel }}"
              aria-label="{{ ui.pdfLabel }}"
            >
              <svg class="w-4 h-4 text-[#ff6b1f] shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
              </svg>
              <span data-i18n-text="cardReference.pdfLabel">{{ ui.pdfLabel }}</span>
            </a>
            {% include "lang-switcher.njk" %}
          </div>
        </div>

        <div class="card-ref-filters" role="group" aria-label="{{ ui.levelLabel }} / {{ ui.typeLabel }}">
          {% for level in [1, 2, 3, 4, 5] %}
          {% if level == 1 %}{% set roman = "I" %}
          {% elif level == 2 %}{% set roman = "II" %}
          {% elif level == 3 %}{% set roman = "III" %}
          {% elif level == 4 %}{% set roman = "IV" %}
          {% else %}{% set roman = "V" %}
          {% endif %}
          <button
            type="button"
            class="card-ref-chip card-ref-chip--icon p-0.5 md:p-1 rounded-md border border-transparent bg-transparent transition"
            data-filter-group="level"
            data-filter-value="{{ level }}"
            aria-pressed="false"
            aria-label="{{ ui.levelLabel }} {{ level }}"
          >
            <img
              src="{{ ('/images/reference_icons/' + roman + '.png') | url }}"
              alt=""
              width="46"
              height="64"
              class="h-7 md:h-9 w-auto pointer-events-none"
              decoding="async"
            >
          </button>
          {% endfor %}

          <span class="card-ref-filters-divider" aria-hidden="true"></span>

          {% for typeKey in ["fighter", "action", "equipment", "sensei"] %}
          <button
            type="button"
            class="card-ref-chip card-ref-chip--icon p-0.5 md:p-1 rounded-md border border-transparent bg-transparent transition"
            data-filter-group="type"
            data-filter-value="{{ typeKey }}"
            aria-pressed="false"
            aria-label="{{ ui.types[typeKey] }}"
          >
            <img
              src="{{ ('/images/reference_icons/' + typeKey + '.png') | url }}"
              alt=""
              width="48"
              height="48"
              class="h-7 w-7 md:h-9 md:w-9 object-contain pointer-events-none"
              decoding="async"
            >
          </button>
          {% endfor %}
        </div>
      </div>
    </div>
  </div>

  <div class="container mx-auto px-2 sm:px-4 py-3 sm:py-4">
    <ul class="grid grid-cols-3 sm:grid-cols-4 md:grid-cols-6 lg:grid-cols-8 xl:grid-cols-10 gap-2 sm:gap-3 list-none p-0 m-0">
      {% for card in cards %}
      <li
        data-card
        data-level="{{ card.level if card.level else '' }}"
        data-type="{{ card.type }}"
        data-full="{{ card.file | url }}"
        data-alt="{{ card.alt }}"
        {% if card.comments and card.comments.length %}data-comments='{{ card.comments | json }}'{% endif %}
      >
        <button
          type="button"
          class="card-ref-item group relative w-full p-0 border-0 bg-transparent cursor-pointer focus:outline-none focus-visible:ring-2 focus-visible:ring-[#2d5a27] focus-visible:ring-offset-2 rounded-md"
          aria-label="{{ card.name }}"
        >
          <img
            src="{{ card.thumb | url }}"
            alt=""
            width="150"
            height="210"
            loading="lazy"
            decoding="async"
            class="w-full h-auto rounded-md shadow-sm transition group-hover:shadow-md group-active:scale-[0.98] pointer-events-none"
          >
          {% if card.comments and card.comments.length %}
          <span
            class="card-ref-comment-badge"
            tabindex="0"
            aria-label="{{ ui.commentsAria }}"
            data-i18n-aria="cardReference.commentsAria"
          >
            <svg class="card-ref-comment-badge__icon" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
            </svg>
            <span class="card-ref-comment-tooltip" role="tooltip">
              {% for note in card.comments %}
              <span class="card-ref-comment-tooltip__item">{{ note }}</span>
              {% endfor %}
            </span>
          </span>
          {% endif %}
        </button>
      </li>
      {% endfor %}
    </ul>

    <p id="card-reference-empty" class="hidden text-center text-gray-600 py-16 px-4">{{ ui.empty }}</p>
  </div>

  <div
    id="card-reference-lightbox"
    class="fixed inset-0 z-[100] hidden flex items-center justify-center p-3 sm:p-6 bg-black/85 backdrop-blur-sm"
    role="dialog"
    aria-modal="true"
    aria-labelledby="card-reference-lightbox-caption"
  >
    <button
      type="button"
      id="card-reference-lightbox-close"
      class="absolute top-3 right-3 sm:top-4 sm:right-4 rounded-full bg-white/10 p-2.5 text-white hover:bg-white/20 focus:outline-none focus:ring-2 focus:ring-white"
      aria-label="{{ ui.close }}"
    >
      <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
    </button>
    <button
      type="button"
      id="card-reference-lightbox-prev"
      class="absolute left-1 sm:left-4 top-1/2 -translate-y-1/2 rounded-full bg-white/10 p-3 text-white hover:bg-white/20 focus:outline-none focus:ring-2 focus:ring-white"
      aria-label="{{ ui.previous }}"
    >
      <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
    </button>
    <button
      type="button"
      id="card-reference-lightbox-next"
      class="absolute right-1 sm:right-4 top-1/2 -translate-y-1/2 rounded-full bg-white/10 p-3 text-white hover:bg-white/20 focus:outline-none focus:ring-2 focus:ring-white"
      aria-label="{{ ui.next }}"
    >
      <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
    </button>
    <figure class="card-ref-lightbox-figure max-h-[92vh] max-w-[min(100vw,28rem)] w-full flex flex-col">
      <img id="card-reference-lightbox-img" src="" alt="" class="card-ref-lightbox-img mx-auto max-h-[82vh] w-auto max-w-full object-contain rounded-lg shadow-2xl">
      <figcaption id="card-reference-lightbox-caption" class="mt-3 text-center text-sm sm:text-base text-white/90 font-headings font-semibold shrink-0"></figcaption>
      <div id="card-reference-lightbox-comments" class="card-ref-lightbox-comments hidden mt-3 shrink-0" aria-live="polite">
        <p id="card-reference-lightbox-comments-title" class="card-ref-lightbox-comments__title">{{ ui.commentsTitle }}</p>
        <ul id="card-reference-lightbox-comments-list" class="card-ref-lightbox-comments__list"></ul>
      </div>
    </figure>
  </div>
</section>

<style>
  .card-ref-filters {
    display: flex;
    align-items: center;
    width: 100%;
    justify-content: space-between;
    gap: 0.125rem;
  }
  .card-ref-filters-divider {
    flex-shrink: 0;
    width: 1px;
    height: 1.5rem;
    margin: 0 0.125rem;
    background-color: #d1d5db;
  }
  @media (min-width: 768px) {
    .card-ref-filters {
      width: auto;
      justify-content: flex-start;
      gap: 0.5rem;
    }
    .card-ref-filters-divider {
      height: 2rem;
      margin: 0 0.75rem;
    }
  }
  .card-ref-chip.is-active,
  .card-ref-chip[aria-pressed="true"] {
    background-color: #2d5a27;
    border-color: #2d5a27;
    color: #fff;
  }
  .card-ref-chip--icon {
    opacity: 0.55;
  }
  .card-ref-chip--icon.is-active,
  .card-ref-chip--icon[aria-pressed="true"] {
    opacity: 1;
    background-color: rgba(45, 90, 39, 0.12);
    border-color: #2d5a27;
  }

  .card-ref-comment-badge {
    position: absolute;
    right: 0.2rem;
    bottom: 0.2rem;
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 1.25rem;
    height: 1.25rem;
    border-radius: 0.3rem;
    background: rgba(255, 255, 255, 0.95);
    color: #ff6b1f;
    box-shadow: 0 1px 4px rgba(0, 0, 0, 0.18);
    pointer-events: auto;
  }

  .card-ref-comment-badge__icon {
    width: 0.85rem;
    height: 0.85rem;
  }

  .card-ref-comment-tooltip {
    position: absolute;
    right: 0;
    bottom: calc(100% + 0.35rem);
    z-index: 30;
    display: none;
    width: max-content;
    max-width: min(16rem, 70vw);
    padding: 0.5rem 0.65rem;
    border-radius: 0.5rem;
    background: #1f2937;
    color: #f9fafb;
    font-size: 0.7rem;
    line-height: 1.35;
    text-align: left;
    box-shadow: 0 8px 20px rgba(0, 0, 0, 0.25);
    pointer-events: none;
  }

  .card-ref-comment-tooltip__item {
    display: block;
  }

  .card-ref-comment-tooltip__item + .card-ref-comment-tooltip__item {
    margin-top: 0.35rem;
    padding-top: 0.35rem;
    border-top: 1px solid rgba(255, 255, 255, 0.12);
  }

  .card-ref-comment-tooltip__item::before {
    content: "• ";
    color: #ff6b1f;
  }

  .card-ref-comment-badge:hover .card-ref-comment-tooltip,
  .card-ref-comment-badge:focus .card-ref-comment-tooltip,
  .card-ref-comment-badge:focus-within .card-ref-comment-tooltip {
    display: block;
  }

  .card-ref-lightbox-img.has-comments {
    max-height: 62vh;
  }

  .card-ref-lightbox-comments {
    width: 100%;
    padding: 0.75rem 0.9rem;
    border-radius: 0.75rem;
    border: 1px solid rgba(255, 255, 255, 0.2);
    background: rgba(255, 255, 255, 0.08);
    max-height: 30vh;
    overflow-y: auto;
  }

  .card-ref-lightbox-comments__title {
    margin: 0 0 0.5rem;
    font-family: inherit;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.65);
  }

  .card-ref-lightbox-comments__list {
    margin: 0;
    padding-left: 1rem;
    color: rgba(255, 255, 255, 0.88);
    font-size: 0.875rem;
    line-height: 1.45;
  }

  .card-ref-lightbox-comments__list li + li {
    margin-top: 0.45rem;
  }
</style>

<script src="{{ '/js/card-reference.js' | url }}?v={{ buildTime }}"></script>
