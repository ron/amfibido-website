{# Expects: t (rules translations), lang ("en"|"nl"), referenceUrl #}
<div class="rules-hub">
  <div class="flex items-center justify-between gap-3 mb-4 md:mb-6">
    <h1 class="text-3xl md:text-5xl font-headings font-bold text-[#2d5a27] leading-tight">{{ t.title }}</h1>
    {% include "lang-switcher.njk" %}
  </div>

  <p class="text-sm md:text-lg text-gray-600 md:text-gray-700 max-w-2xl mb-4 md:mb-8 leading-snug">{{ t.subtitle }}</p>

  <div class="flex flex-col gap-2.5 md:gap-4 mb-8 md:mb-12">
    <a
      href="{{ t.manualPdf | url }}"
      target="_blank"
      rel="noopener noreferrer"
      data-i18n-href="rules.manualPdf"
      class="rules-hub__action group flex items-center gap-3 md:gap-4 rounded-2xl border border-gray-200 bg-white px-3.5 py-3 md:px-5 md:py-4 shadow-sm transition hover:border-[#ff6b1f]/40 hover:shadow-md"
    >
      <span class="flex h-11 w-11 md:h-14 md:w-14 shrink-0 items-center justify-center rounded-xl bg-[#ff6b1f]/10 text-[#ff6b1f]">
        <svg class="w-6 h-6 md:w-7 md:h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
        </svg>
      </span>
      <span class="min-w-0 flex-1 text-left">
        <span class="block font-headings font-bold text-[#2d5a27] text-base md:text-xl">{{ t.manualTitle }}</span>
        <span class="hidden md:block text-sm text-gray-600 mt-0.5">{{ t.manualBody }}</span>
        <span class="md:hidden text-sm text-gray-500">{{ t.manualCta }}</span>
      </span>
      <svg class="w-5 h-5 shrink-0 text-gray-400 group-hover:text-[#ff6b1f] transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
      </svg>
    </a>

    <button
      type="button"
      id="ask-minami-btn"
      class="rules-hub__action group flex items-center gap-3 md:gap-4 rounded-2xl border border-gray-200 bg-white px-3.5 py-3 md:px-5 md:py-4 shadow-sm transition hover:border-[#2d5a27]/40 hover:shadow-md cursor-pointer text-left w-full"
    >
      <span class="flex h-11 w-11 md:h-14 md:w-14 shrink-0 items-center justify-center rounded-xl bg-[#2d5a27]/10 overflow-hidden">
        <img src="{{ '/images/mr-minami.png' | url }}" alt="" class="h-9 w-9 md:h-11 md:w-11 object-contain">
      </span>
      <span class="min-w-0 flex-1">
        <span class="block font-headings font-bold text-[#2d5a27] text-base md:text-xl">{{ t.minamiTitle }}</span>
        <span class="hidden md:block text-sm text-gray-600 mt-0.5">{{ t.minamiBody }}</span>
        <span class="md:hidden text-sm text-gray-500">{{ t.minamiCta }}</span>
      </span>
      <svg class="w-5 h-5 shrink-0 text-gray-400 group-hover:text-[#2d5a27] transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
      </svg>
    </button>

    <a
      href="{{ referenceUrl | url }}"
      class="rules-hub__action group flex items-center gap-3 md:gap-4 rounded-2xl border border-gray-200 bg-white px-3.5 py-3 md:px-5 md:py-4 shadow-sm transition hover:border-[#2d5a27]/40 hover:shadow-md"
    >
      <span class="flex h-11 w-11 md:h-14 md:w-14 shrink-0 items-center justify-center rounded-xl bg-[#2d5a27]/10 text-[#2d5a27]">
        <svg class="w-6 h-6 md:w-7 md:h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"/>
        </svg>
      </span>
      <span class="min-w-0 flex-1 text-left">
        <span class="block font-headings font-bold text-[#2d5a27] text-base md:text-xl">{{ t.referenceTitle }}</span>
        <span class="hidden md:block text-sm text-gray-600 mt-0.5">{{ t.referenceBody }}</span>
        <span class="md:hidden text-sm text-gray-500">{{ t.referenceCta }}</span>
      </span>
      <svg class="w-5 h-5 shrink-0 text-gray-400 group-hover:text-[#2d5a27] transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
      </svg>
    </a>
  </div>

  <div class="bg-white rounded-2xl border border-gray-200 shadow-sm overflow-hidden">
    <div class="px-4 py-3 md:p-6 border-b border-gray-100">
      <h2 class="text-lg md:text-xl font-headings font-bold text-[#2d5a27] text-center">{{ t.videoTitle }}</h2>
      <p id="rules-video-note" class="text-sm text-gray-500 text-center mt-1 md:mt-2{% if lang != 'nl' %} hidden{% endif %}" data-note-nl="{{ t.videoNoteNl }}">{{ t.videoNoteNl }}</p>
    </div>
    <div class="aspect-video bg-gray-50">
      <iframe
        id="rules-tutorial-video"
        class="w-full h-full"
        src="{% if lang == 'nl' %}https://www.youtube-nocookie.com/embed/7Eqj0hTTLEU{% else %}https://www.youtube-nocookie.com/embed/sCV98bm-EgM{% endif %}"
        title="{% if lang == 'nl' %}{{ t.videoTitleNl }}{% else %}{{ t.videoTitleEn }}{% endif %}"
        loading="lazy"
        frameborder="0"
        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
        referrerpolicy="strict-origin-when-cross-origin"
        allowfullscreen
      ></iframe>
    </div>
  </div>
</div>
